generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  password String
  role Role @default(USER)

  sessions Session[]
  products Product[]
}

model Session {
  id Int @id @default(autoincrement())
  userId Int
  userAgent String?
  ip String?
  createAt DateTime @default(now())

  user User @relation(fields: [userId] , references: [id] , onDelete: Cascade)
  refeshToken RefreshToken?

  @@index([userId])
  @@index([ip])
  @@index([createAt])
}

model RefreshToken {
  id Int @id @default(autoincrement())
  token String
  sessionId Int @unique
  expiresAt DateTime

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Product {
  id Int @id @default(autoincrement())
  name String
  description String
  price Float
  createAt DateTime @default(now())
  deletedAt   DateTime?
  userId Int

  user User @relation(fields: [userId], references: [id] , onDelete: Cascade)

  @@index([userId,deletedAt,createAt])
  @@index([price])
}

